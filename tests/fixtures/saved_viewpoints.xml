        </viewpoint>
      </view>
      <view name="Ambiguous_Clash" guid="amb-vp-002">
        <viewpoint>
          <camera projection="persp">
            <position><pos3f x="2.0" y="2.0" z="2.0"/></position>
            <rotation><quaternion a="0.0" b="0.0" c="0.0" d="1.0"/></rotation>
          </camera>
        </viewpoint>
      </view>
    </viewfolder>
  </viewpoints>

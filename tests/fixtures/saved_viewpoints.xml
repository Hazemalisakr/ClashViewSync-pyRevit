            <rotation>
              <quaternion a="0.270598" b="0.270598" c="0.653281" d="0.653281"/>
            </rotation>
          </camera>
        </viewpoint>
      </view>

      <!-- Ambiguous pair: two different viewpoints with identical name and no clash guid match -->
      <view name="Ambiguous_Clash" guid="amb-vp-001">
        <viewpoint>
          <camera projection="persp">
            <position><pos3f x="1.0" y="1.0" z="1.0"/></position>
            <rotation><quaternion a="0.0" b="0.0" c="0.0" d="1.0"/></rotation>
